# Honda (CRF300L) secrets — copy to honda.env and fill in. honda.env is gitignored.
# Standalone app: no Traccar, no shared creds. Single self-contained env file.
# Values single-quoted so `source` keeps the bcrypt $-string literal.

HONDA_AUTH_USERNAME='elgars'
# bcrypt hash of the login password:
#   node -e "console.log(require('bcryptjs').hashSync('YOUR_PASSWORD', 12))"
HONDA_AUTH_PASSWORD_HASH='PASTE_BCRYPT_HASH'
# 48 random bytes, base64url (iron-session key):
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
HONDA_SESSION_PASSWORD='PASTE_48_RANDOM_BYTES_BASE64URL'
