# Sentry secrets — copy to sentry.env and fill in. sentry.env is gitignored.
# NOTE: Pushover creds are NOT here — sentry shares them with tracker, so
# sentry/deploy.sh ALSO sources secrets/tracker.env (single source of truth).

# Dedicated read-only Traccar user sentry uses to read the event stream
# (administrator=false, readonly=true, linked to the FMC880 only).
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
SENTRY_TRACCAR_USERNAME='sentry'
SENTRY_TRACCAR_PASSWORD='PASTE_RANDOM_PASSWORD'
