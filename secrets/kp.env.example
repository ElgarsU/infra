# KP (gym trainer app) secrets — copy to kp.env and fill in. kp.env is gitignored.
# Standalone app: no shared creds. Single self-contained env file.

# Password for the trainer login at hyrox.elgars.eu/login (plain text; letters,
# digits and dashes only — it is written unquoted into a systemd EnvironmentFile).
KP_TRAINER_PASSWORD='PASTE_TRAINER_PASSWORD'

# Cloudflare Turnstile (bot check on the public request form and login).
# Optional: leave empty to keep it off. Create a widget for kpfitness.lv in the
# Cloudflare dashboard (Turnstile → Add widget, mode "Managed").
KP_TURNSTILE_SITE_KEY=''
KP_TURNSTILE_SECRET_KEY=''
