# Tracker (Traccar) secrets — copy to tracker.env and fill in. tracker.env is gitignored.
# This file is also the SINGLE SOURCE for two cross-app secrets:
#   • PUSHOVER_*          — shared with sentry (sentry/deploy.sh sources this file)
#   • HUSKY_TRACCAR_*     — the read-only Traccar user tracker CREATES; the husky
#                           app consumes the same creds (husky/deploy.sh sources this)
# Values are single-quoted so `source` treats them literally.

# Postgres password for the `traccar` role. 32+ urlsafe chars.
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
POSTGRES_TRACCAR_PASSWORD='PASTE_RANDOM_32_PLUS_CHARS'

# Personal Traccar admin (INSERTed into tc_users on bootstrap; Traccar v6 never
# seeds admin/admin on Postgres).
TRACCAR_ADMIN_USERNAME='elgars'
TRACCAR_ADMIN_PASSWORD='PASTE_RANDOM_PASSWORD'

# Pushover (https://pushover.net). SHARED with sentry. If left as PASTE_, the
# tracker role skips all Pushover config (Traccar still starts).
PUSHOVER_USER='PASTE_PUSHOVER_USER_KEY'
PUSHOVER_TOKEN='PASTE_PUSHOVER_APP_API_TOKEN'

# Dedicated read-only Traccar user for the husky app (administrator=false,
# readonly=true, linked to the FMC880 only). tracker creates it; husky reads it.
HUSKY_TRACCAR_USERNAME='husky'
HUSKY_TRACCAR_PASSWORD='PASTE_RANDOM_PASSWORD'
# Operator-managed: generate via Traccar UI after first deploy (husky → Account →
# Generate API Token). Not consumed by Ansible. Leave empty until then.
HUSKY_TRACCAR_API_TOKEN=''
