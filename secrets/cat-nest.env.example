# cat-nest secrets: copy to cat-nest.env and fill in (cat-nest.env is gitignored).
# Values single-quoted so `source` keeps them literal.

# Viessmann developer portal API client (app.developer.viessmann-climatesolutions.com).
# Not secret, but kept out of code. Redirect URI registered as http://localhost:4200/
VIESSMANN_CLIENT_ID='PASTE_VIESSMANN_CLIENT_ID'

# healthchecks.io check ping URL (dead-man's switch). SECRET: anyone with it can
# send false OK/fail pings. Check settings: Period 5 min, Grace 15 min.
HC_PING_URL='https://hc-ping.com/PASTE-CHECK-UUID'

# Unguessable path segment for the public status page UptimeRobot watches:
#   https://nest.elgars.eu/<CATNEST_STATUS_PATH>/vitodens-status
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
CATNEST_STATUS_PATH='PASTE_RANDOM_URLSAFE_32_PLUS_CHARS'
