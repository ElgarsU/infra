# forge secrets — copy to forge.env and fill in (gitignored).

# SHA-256 of "username:password" for the single-user login. The app reads this
# from the FORGE_AUTH_HASH env var (migrated out of the repo's source code).
#   printf '%s' 'elgars:YOUR_PASSWORD' | shasum -a 256
FORGE_AUTH_HASH='PASTE_SHA256_OF_USER_COLON_PASSWORD'
