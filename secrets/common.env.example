# Shared infra secrets — copy to common.env and fill in. common.env is gitignored.
# Values are single-quoted so `source` treats them literally (never expands $…).

# Cloudflare API token for DNS-01 TLS (the shared *.elgars.eu cert challenge).
# Used by the base `caddy` role to write /etc/caddy/cloudflare.env.
# Create at: Cloudflare → My Profile → API Tokens → Create Custom Token
#   Permissions: Zone → DNS → Edit ; Zone Resources: elgars.eu
CF_API_TOKEN='PASTE_YOUR_CLOUDFLARE_API_TOKEN'
