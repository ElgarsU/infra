# Husky secrets — copy to husky.env and fill in. husky.env is gitignored.
# NOTE: the shared Traccar read-only creds (HUSKY_TRACCAR_USERNAME / _PASSWORD /
# _API_TOKEN) are NOT here — they live in secrets/tracker.env (tracker creates
# that user), and husky/deploy.sh ALSO sources tracker.env. Single source.
# Values single-quoted so `source` keeps the bcrypt $-string literal.

HUSKY_AUTH_USERNAME='elgars'
# bcrypt hash of the login password:
#   node -e "console.log(require('bcryptjs').hashSync('YOUR_PASSWORD', 12))"
HUSKY_AUTH_PASSWORD_HASH='PASTE_BCRYPT_HASH'
# 48 random bytes, base64url (iron-session key):
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
HUSKY_SESSION_PASSWORD='PASTE_48_RANDOM_BYTES_BASE64URL'

# Traccar live-dashboard relay target + the FE 350's numeric device id.
HUSKY_TRACCAR_URL='https://track.elgars.eu'
HUSKY_TRACCAR_DEVICE_ID='1'
