# Managed by infra apps/husky/ansible/playbook.yml.
[Unit]
Description=Husky · FE 350 Heritage maintenance log
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ husky_user }}
Group={{ husky_user }}
WorkingDirectory={{ husky_app_dir }}/app
EnvironmentFile={{ husky_app_dir }}/.env
ExecStart=/usr/bin/node {{ husky_app_dir }}/app/.output/server/index.mjs
Restart=always
RestartSec=5
# Light sandboxing — app reads/writes its own data dir, nothing else
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ReadWritePaths={{ husky_data_dir }}

[Install]
WantedBy=multi-user.target
