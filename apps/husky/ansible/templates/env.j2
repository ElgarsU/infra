# Managed by infra apps/husky/ansible/playbook.yml. Mode 0600, owned by `husky`.
# Loaded by husky.service via systemd EnvironmentFile.

NUXT_AUTH_USERNAME={{ husky_auth_username }}
NUXT_AUTH_PASSWORD_HASH={{ husky_auth_password_hash }}
NUXT_SESSION_PASSWORD={{ husky_session_password }}
HUSKY_DB_PATH=/opt/husky/data/husky.sqlite
NODE_ENV=production
HOST=127.0.0.1
PORT={{ husky_internal_port }}

# Traccar live-dashboard relay (server-only)
NUXT_TRACCAR_BASE_URL={{ husky_traccar_url }}
NUXT_TRACCAR_USERNAME={{ husky_traccar_username }}
NUXT_TRACCAR_PASSWORD={{ husky_traccar_password }}
NUXT_TRACCAR_API_TOKEN={{ husky_traccar_api_token | default('') }}
NUXT_TRACCAR_DEVICE_ID={{ husky_traccar_device_id }}
