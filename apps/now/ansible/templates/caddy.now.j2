# Managed by infra apps/now/ansible/playbook.yml.
# now.elgars.eu: the static React build from {{ now_web_root }}, with /api and
# /auth/* proxied to the Go API. Every other path falls back to index.html (the
# app keeps its screens in history state; the URL is always /).
# DNS-01 TLS (works behind Cloudflare orange-cloud).

{{ now_domain }} {
    tls {
        dns cloudflare {env.CF_API_TOKEN}
    }
    encode zstd gzip
    import security_headers
    header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"

    @api path /api /auth/*
    handle @api {
        reverse_proxy 127.0.0.1:{{ now_internal_port }}
    }
    # Vite names these by content hash, so they never change.
    handle /assets/* {
        root * {{ now_web_root }}
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }
    handle {
        root * {{ now_web_root }}
        try_files {path} /index.html
        header Cache-Control "no-cache"
        file_server
    }
}
