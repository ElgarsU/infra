# Managed by infra apps/honda/ansible/playbook.yml. Mode 0600, owned by `honda`.
# Loaded by honda.service via systemd EnvironmentFile.

NUXT_AUTH_USERNAME={{ honda_auth_username }}
NUXT_AUTH_PASSWORD_HASH={{ honda_auth_password_hash }}
NUXT_SESSION_PASSWORD={{ honda_session_password }}
HONDA_DB_PATH=/opt/honda/data/honda.sqlite
NODE_ENV=production
HOST=127.0.0.1
PORT={{ honda_internal_port }}
