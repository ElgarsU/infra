# Managed by infra apps/cat-nest/ansible/playbook.yml. Mode 0600 (holds the healthchecks.io URL).
# Read by cat-nest.service and cat-nest-ewelink.service (EnvironmentFile) and by
# /usr/local/bin/cat-nest. Also holds the eWeLink app secret.
VIESSMANN_CLIENT_ID={{ cn_client_id }}
HC_PING_URL={{ cn_hc_ping_url }}
CATNEST_DATA_DIR={{ cn_data_dir }}
CATNEST_STATE_DIR={{ cn_state_dir }}
CATNEST_STATUS_HOST=127.0.0.1
CATNEST_STATUS_PORT={{ cn_port }}
CATNEST_POLL_INTERVAL=120
CATNEST_SENSOR_IGNORE=heating.dhw.sensors.temperature.outlet
CATNEST_TZ=Europe/Riga
CATNEST_LAT=57.54
CATNEST_LON=25.43
PYTHONDONTWRITEBYTECODE=1
PYTHONUNBUFFERED=1
EWELINK_APP_ID={{ ew_app_id }}
EWELINK_APP_SECRET={{ ew_app_secret }}
EWELINK_REGION={{ ew_region }}
HC_PING_URL_EW={{ ew_hc_ping_url }}
EWELINK_STATUS_PORT={{ ew_port }}
EWELINK_POLL_INTERVAL=300
