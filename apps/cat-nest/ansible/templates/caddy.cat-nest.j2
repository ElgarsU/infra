# Managed by infra apps/cat-nest/ansible/playbook.yml.
# Mode 0640 root:caddy: this file holds the secret status path.
#
# Only the two status pages UptimeRobot watches are served (boiler and eWeLink
# room sensors). Caddy rewrites each to /status on that logger's 127.0.0.1
# listener. Everything else is a 404.
{{ cn_host }} {
    tls {
        dns cloudflare {env.CF_API_TOKEN}
    }
    import security_headers

    handle /{{ cn_status_path }}/vitodens-status {
        rewrite * /status
        reverse_proxy 127.0.0.1:{{ cn_port }}
    }

    handle /{{ cn_status_path }}/ewelink-status {
        rewrite * /status
        reverse_proxy 127.0.0.1:{{ ew_port }}
    }

    handle {
        respond 404
    }
}
